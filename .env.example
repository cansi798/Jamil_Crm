# Platzhalter für Umgebungsvariablen – echte Werte gehören in .env (nicht committen).

# Datenbank-Verbindung (Superuser crm, nur für Migrationen und Tests)
PGHOST=
PGPORT=
PGUSER=
PGDATABASE=crm
PGPASSWORD=

# Passwörter der eingeschränkten Rollen (je 32 Zeichen, zufällig)
CRM_APP_PASSWORT=
CRM_ADMIN_PASSWORT=
# Rolle crm_auth: ruft nur die Anmelde-Funktionen auf (Sitzungen), keine Tabellenrechte
CRM_AUTH_PASSWORT=

# Verbindungen der Anwendung (optional). Fehlen sie, werden sie aus PGHOST/PGPORT/PGDATABASE
# plus den Passwörtern oben für die Rollen crm_app bzw. crm_admin zusammengesetzt.
DATABASE_URL_APP=
DATABASE_URL_ADMIN=
DATABASE_URL_AUTH=

# Sprachsteuerung und KI (Stufe 1d)
# STT-Dienst crm-stt im internen Netz der Sandbox
CRM_STT_URL=http://crm-stt:8080
# KI-Anbieter: mistral (nur mit Schlüssel), openai-kompatibel (z. B. Xiaomi MiMo, mittwald) oder fake (Standard)
CRM_KI_ANBIETER=fake
# Mistral-API-Schlüssel – nur in der Umgebung, nie im Repo
CRM_MISTRAL_KEY=
# OpenAI-kompatibel: Adresse bis /v1 (MiMo: https://token-plan-ams.xiaomimimo.com/v1) und Schlüssel (nie im Repo)
CRM_KI_URL=
CRM_KI_KEY=
# Modelle (optional bei Mistral): Hauptmodell, schnelles Modell für Sprachbefehle, Fotos im Angebotsentwurf
CRM_KI_MODELL=
CRM_KI_MODELL_SCHNELL=
CRM_KI_MODELL_FOTO=
# nur MiMo: ja = ohne Nachdenk-Phase (schneller)
CRM_KI_OHNE_NACHDENKEN=
# Geheimnis für signierte Sprach-Vorschläge (HMAC-SHA256, mind. 32 Zeichen, zufällig)
CRM_VORSCHLAG_GEHEIMNIS=
