# =====================================================================================
#  CRM-System – Einstellungen für diesen Server
# =====================================================================================
#  Diese Datei ist nur eine VORLAGE. Die echte Datei heißt „.env“ und wird von
#  2-installieren.sh automatisch angelegt – mit zufälligen, sicheren Passwörtern.
#  Die echte .env niemals weitergeben oder ins Git hochladen (sie enthält Passwörter).
#
#  Nach einer Änderung an .env:  ./3-starten.sh  (startet die Dienste mit den neuen Werten)
# =====================================================================================

# ---------- Allgemein ----------

# Name dieser Installation (für Docker; nur Kleinbuchstaben, Ziffern, Bindestrich).
# Zwei Installationen auf demselben Server brauchen zwei verschiedene Namen.
CRM_PROJEKT=crm

# Firmenname (nur zur Anzeige in den Skripten; den Betrieb selbst legt der Admin im CRM an).
CRM_FIRMENNAME="Beispiel GmbH"

# Domain, unter der das CRM erreichbar ist (DNS-A-Eintrag muss auf diesen Server zeigen).
CRM_DOMAIN=crm.beispiel.de

# Öffentliche Adresse mit https:// – muss genau zur Domain passen (sonst werden Formulare abgewiesen).
CRM_ORIGIN=https://crm.beispiel.de

# E-Mail für das HTTPS-Zertifikat (Let's Encrypt schickt dorthin Warnungen, z. B. vor Ablauf).
CRM_ZERTIFIKAT_EMAIL=admin@beispiel.de

# Optionale Dienste, mit Komma getrennt:
#   https   = Caddy holt automatisch ein Zertifikat und belegt die Ports 80 und 443
#   sprache = Spracherkennung auf dem eigenen Server (braucht ca. 2 GB Arbeitsspeicher)
# Leer lassen, wenn schon ein anderer Webserver (z. B. ein vorhandener Caddy/Nginx) davor steht.
COMPOSE_PROFILES=https,sprache

# ---------- Ports ----------

# Ports für Caddy (nur mit Profil „https“). Normalerweise 80 und 443 – nicht ändern.
CRM_HTTP_PORT=80
CRM_HTTPS_PORT=443

# Port der App auf diesem Server. 127.0.0.1 = nur lokal (Caddy leitet weiter).
# Ohne Caddy und mit eigenem Webserver davor: CRM_APP_BIND=127.0.0.1 lassen und den Webserver
# auf http://127.0.0.1:CRM_APP_PORT zeigen lassen.
CRM_APP_BIND=127.0.0.1
CRM_APP_PORT=3000

# ---------- Passwörter (werden bei der Installation zufällig erzeugt) ----------

# Hauptpasswort der Datenbank (Superuser „crm“, nur für Migrationen und Sicherungen)
CRM_DB_PASSWORT=
# Passwörter der eingeschränkten Datenbank-Rollen, mit denen die App arbeitet
CRM_APP_PASSWORT=
CRM_ADMIN_PASSWORT=
CRM_AUTH_PASSWORT=
# Geheimnis für signierte Sprach-Vorschläge (mindestens 32 Zeichen, zufällig)
CRM_VORSCHLAG_GEHEIMNIS=
# Geheimnis für das Kundenportal (mindestens 32 Zeichen, zufällig): verschlüsselt die Portal-Links, damit Mitarbeiter
# den aktiven Link wieder öffnen können, und signiert die Portal-Anmeldung. Nie ändern – sonst lassen sich bestehende
# Links nicht mehr öffnen und alle Kunden müssen ihr Passwort neu eingeben.
CRM_PORTAL_GEHEIMNIS=

# ---------- KI (optional) ----------

# Welche KI versteht Sprachbefehle und schreibt Angebotsentwürfe?
# „fake“ = einfache Regeln, ohne externen Dienst (Standard).
# „mistral“ = Mistral-KI (braucht CRM_MISTRAL_KEY, Daten gehen an Mistral in der EU).
# „openai-kompatibel“ = jede KI mit OpenAI-kompatibler Schnittstelle, z. B. Xiaomi MiMo oder mittwald AI Hosting
#   (braucht CRM_KI_URL, CRM_KI_KEY und CRM_KI_MODELL).
# Die KI bekommt nie Kundennamen aus der Datenbank, Adressen oder Preise – nur den gesprochenen Befehl,
# das Datum und beim Angebotsentwurf die Katalog-Leistungen (ohne Preise) und ggf. das Foto.
CRM_KI_ANBIETER=fake
CRM_MISTRAL_KEY=
# Nur für „openai-kompatibel“: Adresse der Schnittstelle (bis einschließlich /v1) und API-Schlüssel.
#   MiMo:     CRM_KI_URL=https://token-plan-ams.xiaomimimo.com/v1
#   mittwald: die Adresse aus dem mittwald-Kundencenter (AI Hosting, endet auf /v1)
CRM_KI_URL=
CRM_KI_KEY=
# Modell der KI. Leer = Standard (bei Mistral: mistral-small-latest).
#   MiMo z. B.: mimo-v2.6-flash (schnell) oder mimo-v2.6-pro (gründlicher); beide verstehen auch Fotos.
CRM_KI_MODELL=
# Optional: schnelleres Modell nur für Sprachbefehle (leer = CRM_KI_MODELL). Ist dessen Antwort ungültig,
# fragt das CRM ein zweites Mal beim Hauptmodell nach.
CRM_KI_MODELL_SCHNELL=
# Optional: eigenes Modell für Fotos im Angebotsentwurf (leer = Standard; bei Mistral: pixtral-12b-latest,
# sonst das Hauptmodell).
CRM_KI_MODELL_FOTO=
# Optional, nur MiMo: KI denkt nicht erst lange nach (schneller, aber evtl. ungenauer).
#   „ja“ = nie nachdenken, „entwurf“ = nur beim Angebotsentwurf nicht (empfohlen für MiMo:
#   Sprachbefehle bleiben genau, Entwürfe kommen in Sekunden statt bis zu einer Minute), leer = immer nachdenken.
CRM_KI_OHNE_NACHDENKEN=

# Rechen-Threads der Spracherkennung (mehr = schneller, aber mehr Last)
CRM_STT_THREADS=2

# ---------- E-Mail (optional) ----------

# Versand von Protokollen per E-Mail, z. B. smtps://benutzer:passwort@mail.beispiel.de:465
# Leer = E-Mail-Versand aus dem CRM ist abgeschaltet.
CRM_SMTP_URL=

# ---------- Erinnerungen per Push (Handy, PC) ----------
# Schlüssel für Web-Push (VAPID). Erzeugt 2-installieren.sh automatisch. Bleiben sie leer, erzeugt das CRM beim
# ersten Bedarf selbst ein Schlüsselpaar und merkt es sich in der Datenbank – das reicht auch.
# Nicht mehr ändern, sobald Geräte Benachrichtigungen eingeschaltet haben (sonst müssen alle sie neu einschalten).
CRM_VAPID_OEFFENTLICH=
CRM_VAPID_PRIVAT=
# Kontakt für die Push-Dienste (Google, Apple, Mozilla), z. B. mailto:info@ihre-firma.de
CRM_VAPID_KONTAKT=

# ---------- Karte (Auftragskarte) ----------
# Das CRM holt die Kartenbilder selbst (mit Zwischenspeicher) – der Browser spricht nie direkt mit dem Kartendienst.
# Standard: OpenStreetMap. Deren Regeln: gut für kleine Betriebe, nicht für viel Verkehr. Bei vielen Nutzern einen
# eigenen Kachel-Server (z. B. OpenMapTiles/tileserver-gl) oder einen Anbieter mit Schlüssel eintragen, z. B.
#   https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=IHR_SCHLUESSEL
# Leer = OpenStreetMap. Muss mit https:// beginnen und {z}, {x}, {y} enthalten.
KARTE_KACHEL_URL=
# Kontakt, den der Kartendienst sieht (Pflicht bei OpenStreetMap), z. B. info@ihre-firma.de
KARTE_KONTAKT=
# Quellenangabe bei einem anderen Kartendienst (nur Text, z. B. „© MapTiler © OpenStreetMap-Mitwirkende“).
# Leer = OpenStreetMap-Hinweis.
KARTE_ATTRIBUTION=

# ---------- Zeiterfassung: Kilometer für Fahrten ----------

# Kilometer zwischen dem letzten Ort und der Baustelle. Leer lassen (Standard): Luftlinie × Umwegfaktor – dabei geht
# nichts an einen fremden Dienst. Wer genaue Straßen-Kilometer möchte, trägt hier einen Routen-Server (OSRM) ein,
# am besten einen eigenen, z. B. CRM_ROUTEN_URL=https://osrm.ihre-firma.de (dorthin gehen nur zwei Koordinaten).
CRM_ROUTEN_URL=
# Umwegfaktor Straße/Luftlinie (1 bis 3). 1,3 ist ein guter Mittelwert für Deutschland.
CRM_ROUTEN_FAKTOR=1.3

# ---------- Online-Buchung (Termine buchen über einen Link) ----------

# Websites, auf denen JEDER Betrieb die Buchungsseite einbetten darf (zusätzlich zu den Websites, die der Chef in
# Einstellungen → Online-Buchung einträgt). Mehrere mit Leerzeichen trennen, nur https, z. B.:
#   CRM_BUCHUNG_EINBETTEN=https://www.ihre-firma.de
# Leer lassen ist in Ordnung (Standard).
CRM_BUCHUNG_EINBETTEN=

# Echte IP-Adresse der Besucher hinter Caddy bzw. einem anderen Webserver (für den Spam-Schutz der Buchungsseite).
# Standard passt zu Caddy. Ohne Webserver davor: beide Zeilen leer lassen.
CRM_ADRESS_KOPF=X-Forwarded-For
CRM_ADRESS_TIEFE=1

# ---------- Nextcloud (optional) ----------
# Das CRM bleibt eigenständig, kann aber mit einer Nextcloud verbunden werden: „Mit Nextcloud anmelden“, Termine im
# Nextcloud-Kalender, Kunden im Nextcloud-Adressbuch, Fotos/Protokolle/Angebote als Dateien, Erinnerungen über Talk.
# Schritt-für-Schritt: ANLEITUNG.md, Abschnitt „Mit Nextcloud verbinden“.
# NEXTCLOUD_URL leer = alles aus (Standard). Die Zugangsdaten unten kommen AUS der Nextcloud – nie selbst ausdenken.

# Öffentliche Adresse der Nextcloud (https://), z. B. https://cloud.ihre-firma.de
NEXTCLOUD_URL=
# Nur nötig, wenn das CRM die Nextcloud intern anders erreicht (z. B. gleicher Server: http://nextcloud). Sonst leer.
NEXTCLOUD_INTERN_URL=
# ID des Betriebs, zu dem die Nextcloud gehört. Leer = der einzige Betrieb dieser Installation (Normalfall).
NEXTCLOUD_BETRIEB=

# „Mit Nextcloud anmelden“ (ja/nein). Braucht die Nextcloud-App „OIDC Identity Provider“ und dort einen Client.
NEXTCLOUD_ANMELDUNG=nein
NEXTCLOUD_OIDC_CLIENT_ID=
NEXTCLOUD_OIDC_CLIENT_SECRET=
# ja = die Nextcloud verlangt bei allen CRM-Nutzern selbst die Zwei-Faktor-Anmeldung (dort erzwungen) – dann fragt das
#      CRM nicht noch einmal nach seinem Code. nein (Standard) = das CRM fragt seinen eigenen Code wie gewohnt ab.
NEXTCLOUD_2FA_VERTRAUEN=nein
# ja (Standard) = bei der ersten Anmeldung wird ein vorhandener CRM-Benutzer mit derselben (von Nextcloud bestätigten)
# E-Mail automatisch verknüpft. nein = nur von Hand verknüpfen (CRM → Nextcloud). Neue CRM-Benutzer entstehen nie.
NEXTCLOUD_PER_EMAIL_VERKNUEPFEN=ja

# Technik-Konto in der Nextcloud (normales Konto OHNE Admin-Rechte) und sein App-Passwort.
# Wird für Kalender, Kontakte, Dateien und Talk gebraucht.
NEXTCLOUD_TECHNIK_BENUTZER=
NEXTCLOUD_TECHNIK_APP_TOKEN=

# Termine/Einsätze jeder verknüpften Person in einem eigenen Nextcloud-Kalender „CRM – Einsätze“ (ja/nein)
NEXTCLOUD_KALENDER=nein
# Kunden im Nextcloud-Adressbuch „CRM Kunden“ (ja/nein) und die Nextcloud-Gruppe, die es sehen darf (z. B. Team)
NEXTCLOUD_KONTAKTE=nein
NEXTCLOUD_KONTAKTE_GRUPPE=
# Fotos, abgeschlossene Protokolle und versendete Angebote als Dateien unter <Ordner>/Kunden/<Kunde>/<Auftrag>/ (ja/nein)
NEXTCLOUD_DATEIEN=nein
# Ordner beim Technik-Konto (am besten ein Gruppenordner, z. B. „CRM“, den das Team sieht)
NEXTCLOUD_DATEIEN_ORDNER=CRM
# Erinnerungen zusätzlich als Talk-Nachricht an die verknüpfte Person (ja/nein)
NEXTCLOUD_TALK=nein
# Wie oft abgeglichen wird (Minuten)
NEXTCLOUD_ABGLEICH_MINUTEN=5

# ---------- Sicherungen ----------

# Ordner für Sicherungen (relativ zu diesem Ordner oder absoluter Pfad)
CRM_SICHERUNG_ORDNER=sicherungen
# Sicherungen, die älter sind als so viele Tage, werden gelöscht (die neuesten 3 bleiben immer)
CRM_SICHERUNG_TAGE=14
