# =====================================================================================
#  CRM-System – Einstellungen für diesen Server
# =====================================================================================
#  Diese Datei ist nur eine VORLAGE. Die echte Datei heißt „.env“ und wird von
#  2-installieren.sh automatisch angelegt – mit zufälligen, sicheren Passwörtern.
#  Die echte .env niemals weitergeben oder ins Git hochladen (sie enthält Passwörter).
#
#  Nach einer Änderung an .env:  ./3-starten.sh  (startet die Dienste mit den neuen Werten)
# =====================================================================================

# ---------- Allgemein ----------

# Name dieser Installation (für Docker; nur Kleinbuchstaben, Ziffern, Bindestrich).
# Zwei Installationen auf demselben Server brauchen zwei verschiedene Namen.
CRM_PROJEKT=crm

# Firmenname (nur zur Anzeige in den Skripten; den Betrieb selbst legt der Admin im CRM an).
CRM_FIRMENNAME="Beispiel GmbH"

# Domain, unter der das CRM erreichbar ist (DNS-A-Eintrag muss auf diesen Server zeigen).
CRM_DOMAIN=crm.beispiel.de

# Öffentliche Adresse mit https:// – muss genau zur Domain passen (sonst werden Formulare abgewiesen).
CRM_ORIGIN=https://crm.beispiel.de

# E-Mail für das HTTPS-Zertifikat (Let's Encrypt schickt dorthin Warnungen, z. B. vor Ablauf).
CRM_ZERTIFIKAT_EMAIL=admin@beispiel.de

# Optionale Dienste, mit Komma getrennt:
#   https   = Caddy holt automatisch ein Zertifikat und belegt die Ports 80 und 443
#   sprache = Spracherkennung auf dem eigenen Server (braucht ca. 2 GB Arbeitsspeicher)
# Leer lassen, wenn schon ein anderer Webserver (z. B. ein vorhandener Caddy/Nginx) davor steht.
COMPOSE_PROFILES=https,sprache

# ---------- Ports ----------

# Ports für Caddy (nur mit Profil „https“). Normalerweise 80 und 443 – nicht ändern.
CRM_HTTP_PORT=80
CRM_HTTPS_PORT=443

# Port der App auf diesem Server. 127.0.0.1 = nur lokal (Caddy leitet weiter).
# Ohne Caddy und mit eigenem Webserver davor: CRM_APP_BIND=127.0.0.1 lassen und den Webserver
# auf http://127.0.0.1:CRM_APP_PORT zeigen lassen.
CRM_APP_BIND=127.0.0.1
CRM_APP_PORT=3000

# ---------- Passwörter (werden bei der Installation zufällig erzeugt) ----------

# Hauptpasswort der Datenbank (Superuser „crm“, nur für Migrationen und Sicherungen)
CRM_DB_PASSWORT=
# Passwörter der eingeschränkten Datenbank-Rollen, mit denen die App arbeitet
CRM_APP_PASSWORT=
CRM_ADMIN_PASSWORT=
CRM_AUTH_PASSWORT=
# Geheimnis für signierte Sprach-Vorschläge (mindestens 32 Zeichen, zufällig)
CRM_VORSCHLAG_GEHEIMNIS=

# ---------- KI (optional) ----------

# „fake“ = einfache Regeln, ohne externen Dienst (Standard).
# „mistral“ = Mistral-KI (braucht einen API-Schlüssel, Daten gehen an Mistral in der EU).
CRM_KI_ANBIETER=fake
CRM_MISTRAL_KEY=
CRM_KI_MODELL=mistral-small-latest
CRM_KI_MODELL_FOTO=pixtral-12b-latest

# Rechen-Threads der Spracherkennung (mehr = schneller, aber mehr Last)
CRM_STT_THREADS=2

# ---------- E-Mail (optional) ----------

# Versand von Protokollen per E-Mail, z. B. smtps://benutzer:passwort@mail.beispiel.de:465
# Leer = E-Mail-Versand aus dem CRM ist abgeschaltet.
CRM_SMTP_URL=

# ---------- Erinnerungen per Push (Handy, PC) ----------
# Schlüssel für Web-Push (VAPID). Erzeugt 2-installieren.sh automatisch. Bleiben sie leer, erzeugt das CRM beim
# ersten Bedarf selbst ein Schlüsselpaar und merkt es sich in der Datenbank – das reicht auch.
# Nicht mehr ändern, sobald Geräte Benachrichtigungen eingeschaltet haben (sonst müssen alle sie neu einschalten).
CRM_VAPID_OEFFENTLICH=
CRM_VAPID_PRIVAT=
# Kontakt für die Push-Dienste (Google, Apple, Mozilla), z. B. mailto:info@ihre-firma.de
CRM_VAPID_KONTAKT=

# ---------- Sicherungen ----------

# Ordner für Sicherungen (relativ zu diesem Ordner oder absoluter Pfad)
CRM_SICHERUNG_ORDNER=sicherungen
# Sicherungen, die älter sind als so viele Tage, werden gelöscht (die neuesten 3 bleiben immer)
CRM_SICHERUNG_TAGE=14
