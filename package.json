{
	"name": "crm-system",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 3000",
		"build": "vite build",
		"preview": "vite preview --host 0.0.0.0 --port 3000",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
